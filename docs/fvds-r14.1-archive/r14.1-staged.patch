+/* Phase profiler: one I frame then one P frame per run, every phase timed.
+ *
+ * The decoders carry opt-in hooks (fvds-profile-nds.h); this ROM injects a
+ * cycle counter, so the hook cost is one indirect call per phase.  The external
+ * phases (reference copy, RGB555 conversion, VRAM upload) are timed here in the
+ * same table so the shares are comparable.  MODE 1 times FAT reads instead.
+ */
+#include <nds.h>
+#include <stdio.h>
+#include <string.h>
+#include <stdint.h>
+#include <fat.h>
+#include <sys/iosupport.h>
+#include <stdarg.h>
+#include "fvds-bits-nds.h"
+#include "fvds-iframe-nds.h"
+#include "fvds-pframe-nds.h"
+#include "fvds-profile-nds.h"
+
+extern const unsigned char f0[], f1[], f2[];
+extern const unsigned int f0_len, f1_len, f2_len;
+
+#define W FRAME_W
+#define H FRAME_H
+#define RUNS 6
+#define WARM 1
+#define FRAMES 2
+#ifndef PROFILE_MODE
+#define PROFILE_MODE 0
+#endif
+
+static uint8_t a_g[W * H], a_r[W * H], a_b[W * H];
+static uint8_t b_g[W * H], b_r[W * H], b_b[W * H];
+static uint16_t rgbbuf[2][W * H];
+static int16_t vectors[NDS_FVDS_PFRAME_VECTOR_BYTES / 2];
+static uint16_t *vram __attribute__((aligned(4)));
+
+static FILE *logf;
+
+static void emit(const char *fmt, ...)
+{
+    va_list ap;
+    va_start(ap, fmt); vprintf(fmt, ap); va_end(ap);
+    if (logf) { va_start(ap, fmt); vfprintf(logf, fmt, ap); va_end(ap); fflush(logf); }
+}
+
+static unsigned to_us(unsigned ticks) { return ticks / (BUS_CLOCK / 1000000u); }
+static uint32_t ticks(void) { return cpuGetTiming(); }
+
+static unsigned crc32_update(unsigned crc, const uint8_t *p, size_t n)
+{
+    while (n--) { crc ^= *p++; for (int k = 0; k < 8; k++) crc = (crc >> 1) ^ (0xEDB88320u & (0u - (crc & 1u))); }
+    return crc;
+}
+
+static size_t src_pull(void *ctx, void *dst, size_t max)
+{
+    struct { const unsigned char *p, *end; } *s = ctx;
+    size_t n = (size_t)(s->end - s->p);
+    if (n > max) n = max;
+    memcpy(dst, s->p, n);
+    s->p += n;
+    return n;
+}
+
+static void copy_planes(const uint8_t *g, const uint8_t *r, const uint8_t *b,
+                        uint8_t *og, uint8_t *orr, uint8_t *ob)
+{
+    uint32_t t0 = ticks();
+    memcpy(og, g, W * H); memcpy(orr, r, W * H); memcpy(ob, b, W * H);
+    fvds_profile_add(FVDS_P_REF_COPY, t0, ticks());
+}
+
+static unsigned to_rgb_and_upload(const uint8_t *g, const uint8_t *r,
+                                  const uint8_t *b, uint16_t *buf)
+{
+    uint32_t t0 = ticks();
+    nds_fvds_iframe_to_rgb555(g, r, b, W, buf, W, W, H);
+    fvds_profile_add(FVDS_P_RGB, t0, ticks());
+    t0 = ticks();
+    dmaCopy(buf, vram, W * H * 2);
+    while (dmaBusy(3)) ;
+    fvds_profile_add(FVDS_P_UPLOAD, t0, ticks());
+    unsigned crc = crc32_update(0xFFFFFFFFu, (const uint8_t *)buf, W * H * 2);
+    return crc ^ 0xFFFFFFFFu;
+}
+
+static void timing_mode(void)
+{
+    static uint8_t chunk[512];
+    char path[48] = "sd:/READ.BIN";
+    const char *dev = 0;
+    for (int i = 3; i < 32; i++)
+        if (devoptab_list[i] && devoptab_list[i]->name) { dev = devoptab_list[i]->name; break; }
+    snprintf(path, sizeof path, "%s:/READ.BIN", dev ? dev : "sd");
+    FILE *f = fopen(path, "wb");
+    if (!f) { emit("PH read open=0\n"); return; }
+    for (int i = 0; i < 2048; i++) fwrite(chunk, 1, sizeof chunk, f);
+    fclose(f);
+    f = fopen(path, "rb");
+    if (!f) { emit("PH read open=0\n"); return; }
+    for (int run = 0; run < RUNS + WARM; run++) {
+        static unsigned v[RUNS + WARM];
+        unsigned t0 = ticks(), sum = 0;
+        for (int i = 0; i < 128; i++) sum += fread(chunk, 1, sizeof chunk, f);
+        v[run] = ticks() - t0;
+        if (run >= WARM)
+            emit("PT f=9 total=%u bytes=%u\n", to_us(v[run]), sum);
+        rewind(f);
+    }
+    fclose(f);
+    emit("PH read done=1\n");
+}
+
+int main(void)
+{
+    static unsigned total[RUNS][FRAMES], crc[RUNS][FRAMES];
+    static int st[RUNS][FRAMES];
+    unsigned mode = 0;
+
+    consoleDemoInit();
+    vramSetBankA(VRAM_A_MAIN_BG);
+    videoSetMode(MODE_5_2D);
+    vram = (uint16_t *)BG_BMP_RAM(0);
+    char path[48] = "sd:/P.TXT";
+    if (fatInitDefault()) {
+        const char *dev = 0;
+        for (int i = 3; i < 32; i++)
+            if (devoptab_list[i] && devoptab_list[i]->name) { dev = devoptab_list[i]->name; break; }
+        snprintf(path, sizeof path, "%s:/P.TXT", dev ? dev : "sd");
+        logf = fopen(path, "wb");
+    }
+    mode = PROFILE_MODE;
+    fvds_profile_ticks = ticks;
+    cpuStartTiming(1);
+    emit("R14 profile %s mode=%u fat=%d file=%d arm=1\n", SAMPLE_NAME, mode,
+         logf != 0, logf != 0);
+    if (mode == 1) { timing_mode(); emit("R14 profile done\n"); for (;;) swiWaitForVBlank(); }
+
+    for (int run = 0; run < WARM + RUNS; run++) {
+        for (int idx = 0; idx < FRAMES; idx++) {
+            const unsigned char *pic = idx == 0 ? f0 : f1;
+            unsigned len = idx == 0 ? f0_len : f1_len;
+            struct { const unsigned char *p, *end; } s = { pic, pic + len };
+            nds_fvds_bits b;
+            uint8_t *og = idx == 0 ? b_g : a_g, *orr = idx == 0 ? b_r : a_r, *ob = idx == 0 ? b_b : a_b;
+            const uint8_t *rg = a_g, *rr = a_r, *rb = a_b;
+            unsigned q = 0, dt = 0;
+            nds_fvds_bits_init(&b, src_pull, &s, len);
+            fvds_profile_reset();
+            unsigned t0 = ticks();
+            if (idx == 0) {
+                st[run][idx] = nds_fvds_iframe_decode(&b, og, orr, ob, W, W, H, &q);
+            } else {
+                st[run][idx] = nds_fvds_pframe_decode(&b, rg, rr, rb, og, orr, ob, W, W, H, vectors);
+            }
+            dt = ticks() - t0;
+            if (st[run][idx]) { total[run][idx] = 0; crc[run][idx] = 0; continue; }
+            copy_planes(og, orr, ob, a_g, a_r, a_b);
+            unsigned c = to_rgb_and_upload(a_g, a_r, a_b, rgbbuf[idx]);
+            if (run >= WARM) {
+                total[run - WARM][idx] = dt;
+                crc[run][idx] = c;
+                emit("PT f=%d total=%u crc=%u decode=%u\n", idx, to_us(dt + 0u), c, to_us(dt));
+                for (unsigned s2 = 0; s2 < FVDS_P_SLOTS; s2++)
+                    if (fvds_profile_hits[s2])
+                        emit("PH f=%d s=%u us=%u hits=%u\n", idx, s2,
+                             to_us(fvds_profile_acc[s2]), fvds_profile_hits[s2]);
+            }
+        }
+    }
+    for (int idx = 0; idx < FRAMES; idx++) {
+        unsigned v[RUNS], sum = 0;
+        for (int i = 0; i < RUNS; i++) v[i] = total[i][idx];
+        for (int i = 1; i < RUNS; i++) { unsigned k = v[i]; int j = i - 1; while (j >= 0 && v[j] > k) { v[j + 1] = v[j]; j--; } v[j + 1] = k; }
+        for (int i = 0; i < RUNS; i++) sum += v[i];
+        emit("PS f=%d n=%d min=%u med=%u mean=%u max=%u crc=%u\n", idx, RUNS,
+             to_us(v[0]), to_us(v[RUNS / 2]), to_us(sum / RUNS), to_us(v[RUNS - 1]),
+             crc[RUNS - 1][idx]);
+    }
+    emit("R14 profile done\n");
+    if (logf) { fclose(logf); logf = 0; }
+    for (;;) swiWaitForVBlank();
+    return 0;
+}
