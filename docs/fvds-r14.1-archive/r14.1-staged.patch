diff --git a/cpymo-backends/nds/source/fvds-profile-nds.c b/cpymo-backends/nds/source/fvds-profile-nds.c
new file mode 100644
index 0000000..068584d
--- /dev/null
+++ b/cpymo-backends/nds/source/fvds-profile-nds.c
@@ -0,0 +1,12 @@
+#include "fvds-profile-nds.h"
+#include <string.h>
+
+uint32_t (*fvds_profile_ticks)(void);
+uint32_t fvds_profile_acc[FVDS_P_SLOTS];
+uint32_t fvds_profile_hits[FVDS_P_SLOTS];
+
+void fvds_profile_reset(void)
+{
+    memset(fvds_profile_acc, 0, sizeof fvds_profile_acc);
+    memset(fvds_profile_hits, 0, sizeof fvds_profile_hits);
+}
diff --git a/cpymo-backends/nds/source/fvds-profile-nds.h b/cpymo-backends/nds/source/fvds-profile-nds.h
new file mode 100644
index 0000000..422b4a3
--- /dev/null
+++ b/cpymo-backends/nds/source/fvds-profile-nds.h
@@ -0,0 +1,34 @@
+/* Opt-in phase profiler for the FVDS decoders and the playback path.
+ *
+ * The tick source is injected: a ROM sets fvds_profile_ticks to a cycle
+ * counter, the host tests leave it null and pay one load per phase.  Slots are
+ * fixed so every report has the same shape.
+ */
+#ifndef CPYMO_NDS_FVDS_PROFILE_H
+#define CPYMO_NDS_FVDS_PROFILE_H
+#include <stdint.h>
+
+enum {
+ FVDS_P_I_VLC = 0, FVDS_P_I_COEFF, FVDS_P_I_STORE,
+ FVDS_P_VECTORS, FVDS_P_P_VLC, FVDS_P_INTERP, FVDS_P_RESIDUAL,
+ FVDS_P_P_COPY, FVDS_P_INTRA,
+ FVDS_P_REF_COPY, FVDS_P_RGB, FVDS_P_UPLOAD, FVDS_P_SLOTS
+};
+
+extern uint32_t (*fvds_profile_ticks)(void);
+extern uint32_t fvds_profile_acc[FVDS_P_SLOTS];
+extern uint32_t fvds_profile_hits[FVDS_P_SLOTS];
+
+static inline uint32_t fvds_profile_now(void)
+{
+    return fvds_profile_ticks ? fvds_profile_ticks() : 0u;
+}
+static inline void fvds_profile_add(unsigned slot, uint32_t from, uint32_t to)
+{
+    if (fvds_profile_ticks) {
+        fvds_profile_acc[slot] += to - from;
+        fvds_profile_hits[slot]++;
+    }
+}
+void fvds_profile_reset(void);
+#endif
diff --git a/cpymo-backends/nds/tools/fvds-gpu/Makefile b/cpymo-backends/nds/tools/fvds-gpu/Makefile
new file mode 100644
index 0000000..722f881
--- /dev/null
+++ b/cpymo-backends/nds/tools/fvds-gpu/Makefile
@@ -0,0 +1,126 @@
+#---------------------------------------------------------------------------------
+.SUFFIXES:
+#---------------------------------------------------------------------------------
+
+ifeq ($(strip $(DEVKITARM)),)
+$(error "Please set DEVKITARM in your environment. export DEVKITARM=<path to>devkitARM")
+endif
+
+include $(DEVKITARM)/ds_rules
+
+#---------------------------------------------------------------------------------
+# TARGET is the name of the output
+# BUILD is the directory where object files & intermediate files will be placed
+# SOURCES is a list of directories containing source code
+# INCLUDES is a list of directories containing extra header files
+#---------------------------------------------------------------------------------
+TARGET		:=	$(shell basename $(CURDIR))
+BUILD		:=	build
+SOURCES		:=	gfx source data
+INCLUDES	:=	include build source
+
+#---------------------------------------------------------------------------------
+# options for code generation
+#---------------------------------------------------------------------------------
+ARCH	:=	-march=armv5te -mtune=arm946e-s -marm
+
+CFLAGS	:=	-g -Wall -O2 -ffunction-sections -fdata-sections $(EXTRA) \
+			$(ARCH)
+
+CFLAGS	+=	$(INCLUDE) -DARM9
+CXXFLAGS	:= $(CFLAGS) -fno-rtti -fno-exceptions
+
+ASFLAGS	:=	-g $(ARCH)
+LDFLAGS	=	-specs=ds_arm9.specs -g $(ARCH) -Wl,-Map,$(notdir $*.map)
+
+#---------------------------------------------------------------------------------
+# any extra libraries we wish to link with the project
+#---------------------------------------------------------------------------------
+LIBS	:= -lnds9 -lfat
+
+
+#---------------------------------------------------------------------------------
+# list of directories containing libraries, this must be the top level containing
+# include and lib
+#---------------------------------------------------------------------------------
+LIBDIRS	:=	$(LIBNDS)
+
+#---------------------------------------------------------------------------------
+# no real need to edit anything past this point unless you need to add additional
+# rules for different file extensions
+#---------------------------------------------------------------------------------
+ifneq ($(BUILD),$(notdir $(CURDIR)))
+#---------------------------------------------------------------------------------
+
+export OUTPUT	:=	$(CURDIR)/$(TARGET)
+
+export VPATH	:=	$(foreach dir,$(SOURCES),$(CURDIR)/$(dir))
+export DEPSDIR	:=	$(CURDIR)/$(BUILD)
+
+CFILES		:=	$(foreach dir,$(SOURCES),$(notdir $(wildcard $(dir)/*.c)))
+CPPFILES	:=	$(foreach dir,$(SOURCES),$(notdir $(wildcard $(dir)/*.cpp)))
+SFILES		:=	$(foreach dir,$(SOURCES),$(notdir $(wildcard $(dir)/*.s)))
+BINFILES	:=	$(foreach dir,$(SOURCES),$(notdir $(wildcard $(dir)/*.bin)))
+
+#---------------------------------------------------------------------------------
+# use CXX for linking C++ projects, CC for standard C
+#---------------------------------------------------------------------------------
+ifeq ($(strip $(CPPFILES)),)
+#---------------------------------------------------------------------------------
+	export LD	:=	$(CC)
+#---------------------------------------------------------------------------------
+else
+#---------------------------------------------------------------------------------
+	export LD	:=	$(CXX)
+#---------------------------------------------------------------------------------
+endif
+#---------------------------------------------------------------------------------
+
+export OFILES	:=	$(BINFILES:.bin=.o) \
+					$(CPPFILES:.cpp=.o) $(CFILES:.c=.o) $(SFILES:.s=.o)
+
+export INCLUDE	:=	$(foreach dir,$(INCLUDES),-I$(CURDIR)/$(dir)) \
+					$(foreach dir,$(LIBDIRS),-I$(dir)/include) \
+					-I$(CURDIR)/$(BUILD)
+
+export LIBPATHS	:=	$(foreach dir,$(LIBDIRS),-L$(dir)/lib)
+
+.PHONY: $(BUILD) clean
+
+#---------------------------------------------------------------------------------
+$(BUILD):
+	@[ -d $@ ] || mkdir -p $@
+	@$(MAKE) --no-print-directory -C $(BUILD) -f $(CURDIR)/Makefile
+
+#---------------------------------------------------------------------------------
+clean:
+	@echo clean ...
+	@rm -fr $(BUILD) $(TARGET).elf $(TARGET).nds $(TARGET).ds.gba
+
+
+#---------------------------------------------------------------------------------
+else
+
+DEPENDS	:=	$(OFILES:.o=.d)
+
+#---------------------------------------------------------------------------------
+# main targets
+#---------------------------------------------------------------------------------
+$(OUTPUT).nds	: 	$(OUTPUT).elf
+$(OUTPUT).elf	:	$(OFILES)
+
+#---------------------------------------------------------------------------------
+%.o	:	%.bin
+#---------------------------------------------------------------------------------
+	@echo $(notdir $<)
+	$(bin2o)
+
+
+-include $(DEPENDS)
+
+#---------------------------------------------------------------------------------------
+endif
+#---------------------------------------------------------------------------------------
+CFLAGS += -O3
+CFLAGS += -flto
+LDFLAGS += -flto
diff --git a/cpymo-backends/nds/tools/fvds-gpu/main.c b/cpymo-backends/nds/tools/fvds-gpu/main.c
new file mode 100644
index 0000000..4bfc84a
--- /dev/null
+++ b/cpymo-backends/nds/tools/fvds-gpu/main.c
@@ -0,0 +1,167 @@
+/* DS 3D micro-benchmark: can the engine do a motion-compensation copy batch?
+ *
+ * 768 blocks of 8x8 are drawn as textured quads from a 256x256 source texture
+ * at integer offsets, the framebuffer is read back and compared with the same
+ * copy done by the CPU.  Submission, engine completion and texture upload are
+ * timed separately, so a fast submission that stalls the engine cannot look
+ * like a win.
+ */
+#include <nds.h>
+#include <stdio.h>
+#include <string.h>
+#include <stdint.h>
+#include <fat.h>
+#include <sys/iosupport.h>
+#include <stdarg.h>
+
+#define W 256
+#define H 192
+#define BLOCKS ((W / 8) * (H / 8))
+#define RUNS 5
+#define WARM 1
+
+static uint8_t src[256 * 256];          /* opaque source plane */
+static uint16_t expect[W * H];          /* CPU copy reference */
+static uint16_t *fb;                    /* 3D output, VRAM C */
+static uint16_t *tex;                   /* texture, VRAM A */
+static FILE *logf;
+
+static void emit(const char *fmt, ...)
+{
+    va_list ap;
+    va_start(ap, fmt); vprintf(fmt, ap); va_end(ap);
+    if (logf) { va_start(ap, fmt); vfprintf(logf, fmt, ap); va_end(ap); fflush(logf); }
+}
+static unsigned to_us(unsigned ticks) { return ticks / (BUS_CLOCK / 1000000u); }
+static uint32_t ticks(void) { return cpuGetTiming(); }
+
+static unsigned crc32_update(unsigned crc, const uint8_t *p, size_t n)
+{
+    while (n--) { crc ^= *p++; for (int k = 0; k < 8; k++) crc = (crc >> 1) ^ (0xEDB88320u & (0u - (crc & 1u))); }
+    return crc;
+}
+
+static void fill_source(void)
+{
+    for (int y = 0; y < 256; y++)
+        for (int x = 0; x < 256; x++)
+            src[y * 256 + x] = (uint8_t)((x * 5 + y * 3) & 31);
+}
+
+static void cpu_reference(void)
+{
+    for (int my = 0; my < H / 8; my++)
+        for (int mx = 0; mx < W / 8; mx++) {
+            const uint8_t *s = src + (my * 8 + 2) * 256 + (mx * 8 + 3);
+            uint16_t *d = expect + (my * 8) * W + mx * 8;
+            for (int r = 0; r < 8; r++)
+                for (int c = 0; c < 8; c++)
+                    d[r * W + c] = (uint16_t)(s[r * 256 + c] << 10 | s[r * 256 + c] << 5 | s[r * 256 + c]);
+        }
+}
+
+static void upload_texture(void)
+{
+    for (int y = 0; y < 256; y++)
+        for (int x = 0; x < 256; x++) {
+            unsigned v = src[y * 256 + x];
+            tex[y * 256 + x] = (uint16_t)(v << 10 | v << 5 | v);
+        }
+    dmaCopy(tex, tex, 0);                 /* no-op, keeps the shape explicit */
+    while (dmaBusy(3)) ;
+}
+
+static void submit_quads(void)
+{
+    glBegin(GL_QUADS);
+    for (int my = 0; my < H / 8; my++)
+        for (int mx = 0; mx < W / 8; mx++) {
+            int sx = mx * 8 + 3, sy = my * 8 + 2;
+            int dx = mx * 8, dy = my * 8;
+            glTexCoord2t16(sx * 16, sy * 16);
+            glVertex3v16(dx << 12, dy << 12, 0);
+            glTexCoord2t16((sx + 8) * 16, sy * 16);
+            glVertex3v16((dx + 8) << 12, dy << 12, 0);
+            glTexCoord2t16((sx + 8) * 16, (sy + 8) * 16);
+            glVertex3v16((dx + 8) << 12, (dy + 8) << 12, 0);
+            glTexCoord2t16(sx * 16, (sy + 8) * 16);
+            glVertex3v16(dx << 12, (dy + 8) << 12, 0);
+        }
+    glEnd();
+}
+
+int main(void)
+{
+    static unsigned sub[RUNS + WARM], done[RUNS + WARM], up[RUNS + WARM], crc[RUNS + WARM];
+    unsigned q = 0;
+    consoleDemoInit();
+
+    char path[48] = "sd:/G.TXT";
+    if (fatInitDefault()) {
+        const char *dev = 0;
+        for (int i = 3; i < 32; i++)
+            if (devoptab_list[i] && devoptab_list[i]->name) { dev = devoptab_list[i]->name; break; }
+        snprintf(path, sizeof path, "%s:/G.TXT", dev ? dev : "sd");
+        logf = fopen(path, "wb");
+    }
+    cpuStartTiming(1);
+    fill_source();
+    cpu_reference();
+
+    vramSetBankA(VRAM_A_TEXTURE);
+    vramSetBankC(VRAM_C_LCD);
+    tex = (uint16_t *)VRAM_A;
+    fb = (uint16_t *)VRAM_C;
+    videoSetMode(MODE_0_3D);
+    glInit();
+    glEnable(GL_TEXTURE_2D);
+    glEnable(GL_ANTIALIAS);
+    glClearColor(0, 0, 0, 31);
+    glClearDepth(0x7FFF);
+    glViewport(0, 0, 255, 191);
+    glMatrixMode(GL_PROJECTION);
+    glLoadIdentity();
+    glOrthof32(0, 256, 192, 0, -1 << 12, 1 << 12);
+    glMatrixMode(GL_MODELVIEW);
+    glLoadIdentity();
+    glTranslate3f32(0, 0, 0);
+
+    glGenTextures(1, &q);
+    glBindTexture(0, q);
+    glTexImage2D(0, 0, GL_RGBA, TEXTURE_SIZE_256, TEXTURE_SIZE_256, 0, TEXGEN_TEXCOORD, 0, (uint32_t *)tex);
+    glTexParameter(0, (unsigned)(TEXTURE_SIZE_256 | TEXTURE_SIZE_256 << 4 | GL_RGBA << 26));
+
+    emit("R14 gpu blocks=%u tex=%ux%u run=%u\n", (unsigned)BLOCKS, 256u, 256u, (unsigned)RUNS);
+
+    for (int run = 0; run < WARM + RUNS; run++) {
+        uint32_t t0 = ticks();
+        upload_texture();
+        up[run] = ticks() - t0;
+
+        t0 = ticks();
+        glFlush(GL_TRANS_MANUALSORT);
+        submit_quads();
+        glFlush(GL_TRANS_MANUALSORT);
+        sub[run] = ticks() - t0;
+
+        t0 = ticks();
+        while (GFX_BUSY) ;
+        done[run] = ticks() - t0;
+
+        unsigned c = crc32_update(0xFFFFFFFFu, (const uint8_t *)fb, W * H * 2) ^ 0xFFFFFFFFu;
+        crc[run] = c;
+    }
+    {
+        unsigned c = crc32_update(0xFFFFFFFFu, (const uint8_t *)expect, W * H * 2) ^ 0xFFFFFFFFu;
+        unsigned diff = 0;
+        for (int i = 0; i < W * H; i++) if (fb[i] != expect[i]) diff++;
+        for (int i = WARM; i < WARM + RUNS; i++)
+            emit("PG run=%d up=%u sub=%u done=%u crc=%u\n", i, to_us(up[i]),
+                 to_us(sub[i]), to_us(done[i]), crc[i]);
+        emit("PG expect crc=%u diff=%u\n", c, diff);
+    }
+    emit("R14 gpu done\n");
+    if (logf) { fclose(logf); logf = 0; }
+    for (;;) swiWaitForVBlank();
+    return 0;
+}
