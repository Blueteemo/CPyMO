+#!/bin/bash
+# build-profile.sh TREE CASE OUT [EXTRA_CFLAGS...]
+set -e
+TREE=$(cd "$1" && pwd); CASE=$(cd "$2" && pwd); OUT=$3; shift 3
+HERE=$(cd "$(dirname "$0")" && pwd)
+: "${DEVKITARM:?set DEVKITARM}"
+DEVKITPRO=${DEVKITPRO:-$(dirname "$DEVKITARM")}
+PRIVATE=${CPYMO_FVDS_PRIVATE:?set CPYMO_FVDS_PRIVATE}
+S=$TREE/cpymo-backends/nds/source
+rm -rf "$OUT"; mkdir -p "$OUT/source"
+cp "$HERE/Makefile" "$OUT/"; cp "$HERE/main.c" "$OUT/source/main.c"
+cp "$S/fvds-bits-nds.c" "$S/fvds-bits-nds.h" "$S/fvds-iframe-nds.c" "$S/fvds-iframe-nds.h" "$OUT/source/"
+cp "$S/fvds-pframe-nds.c" "$S/fvds-pframe-nds.h" "$S/fvds-profile-nds.c" "$S/fvds-profile-nds.h" "$OUT/source/"
+cp "$PRIVATE/tables/fvds-vlc-asm-tables.c" "$PRIVATE/tables/fvds-vlc-asm-tables.h" "$OUT/source/"
+EXTRA="-DSAMPLE_NAME=\\\"$(basename "$CASE")\\\""
+DIM=$(python3 "$HERE/gen-data.py" "$CASE" "$OUT/source/data.c")
+EXTRA="$EXTRA $DIM $*"
+cd "$OUT"
+make -s EXTRA="$EXTRA" > build.log 2>&1 || { tail -20 build.log; exit 1; }
+[ -n "${FVDS_DLDI:-}" ] && "$DEVKITPRO/tools/bin/dlditool" "$FVDS_DLDI" "$OUT"/*.nds >/dev/null
+ls -l "$OUT"/*.nds
diff --git a/cpymo-backends/nds/tools/fvds-profile/gen-data.py b/cpymo-backends/nds/tools/fvds-profile/gen-data.py
new file mode 100755
index 0000000..ed76866
--- /dev/null
+++ b/cpymo-backends/nds/tools/fvds-profile/gen-data.py
@@ -0,0 +1,14 @@
+#!/usr/bin/env python3
+"""Embed an I/P/P chain and print the -DFRAME_* geometry flags."""
+import pathlib
+import sys
+
+case, out = pathlib.Path(sys.argv[1]), pathlib.Path(sys.argv[2])
+width, height = (int(v) for v in (case / "dims").read_text().strip().split("x"))
+parts = ["#include <stdint.h>"]
+for index in range(3):
+    data = (case / f"f.{index}.pic").read_bytes()
+    parts.append(f"const unsigned int f{index}_len={len(data)};")
+    parts.append(f"const unsigned char f{index}[{len(data)}]={{{','.join(str(b) for b in data)}}};")
+out.write_text("\n".join(parts) + "\n")
+print(f"-DFRAME_W={width} -DFRAME_H={height}")
