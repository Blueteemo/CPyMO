+#!/bin/bash
+# build-play.sh TREE OUT
+set -eu
+TREE=$1; OUT=$2
+SRC="$TREE/cpymo-backends/nds/source"
+rm -rf "$OUT"; mkdir -p "$OUT/source"
+cp main.c "$OUT/source/"
+for f in fvds-bits-nds.c fvds-iframe-nds.c fvds-pframe-nds.c fvds-stream-nds.c fvds-profile-nds.c fvds-adpcm-nds.c fvds-iframe-tables.c fvds-tables-nds.c fvds-quads-nds.c; do
+  [ -f "$SRC/$f" ] && cp "$SRC/$f" "$OUT/source/"
+done
+for h in "$SRC"/fvds-*.h; do cp "$h" "$OUT/source/"; done
+PRIVATE=${CPYMO_FVDS_PRIVATE:?set CPYMO_FVDS_PRIVATE}
+cp "$PRIVATE/tables/fvds-vlc-asm-tables.c" "$PRIVATE/tables/fvds-vlc-asm-tables.h" "$OUT/source/"
+cp Makefile "$OUT/"
+make -C "$OUT" -j4 >"$OUT/build.log" 2>&1 || { tail -20 "$OUT/build.log"; exit 1; }
+"${DEVKITPRO}/tools/bin/dlditool" "${FVDS_DLDI:?}" "$OUT/play.nds"
+ls -l "$OUT/play.nds"
diff --git a/cpymo-backends/nds/tools/fvds-play/main.c b/cpymo-backends/nds/tools/fvds-play/main.c
new file mode 100644
index 0000000..0d3f94d
--- /dev/null
+++ b/cpymo-backends/nds/tools/fvds-play/main.c
@@ -0,0 +1,231 @@
+/* R14 continuous playback prototype.
+ *
+ * Reads a real FVDS container from the DLDI card, decodes I and P pictures in
+ * order, converts to RGB555, uploads to the display and logs one record per
+ * frame.  B stops, EOF and corrupt packets are reported, and a frame that
+ * misses its deadline is counted as a drop instead of being hidden.
+ *
+ * The container is synthetic: the three payloads of the private sample are
+ * replayed in a 12 frame group of pictures, so the pictures drift away from a
+ * real encode after the first group.  That is a property of this fixture, not
+ * of the decoder, and is stated in the report.
+ */
+#include <nds.h>
+#include <stdio.h>
+#include <string.h>
+#include <stdint.h>
+#include <stdarg.h>
+#include <fat.h>
+#include <sys/iosupport.h>
+
+#include "fvds-bits-nds.h"
+#include "fvds-iframe-nds.h"
+#include "fvds-pframe-nds.h"
+#include "fvds-stream-nds.h"
+#include "fvds-adpcm-nds.h"
+
+#define W 256
+#define H 192
+#define PIX (W * H)
+#define MAXF 150u
+#define LOG_EVERY 10u
+
+static uint8_t a_g[PIX], a_r[PIX], a_b[PIX];
+static uint8_t b_g[PIX], b_r[PIX], b_b[PIX];
+static uint16_t rgbbuf[PIX];
+static int16_t vectors[NDS_FVDS_PFRAME_VECTOR_BYTES];
+static uint8_t packet[65536 + 1024];
+static uint8_t audiobuf[8 * 1024];
+static int16_t pcm[NDS_FVDS_ADPCM_INTERLEAVED_SAMPLES * 40];
+static nds_fvds_bits bits;
+static nds_fvds_stream stream;
+static FILE *logf;
+
+static void emit(const char *fmt, ...)
+{
+    va_list ap;
+    va_start(ap, fmt); vprintf(fmt, ap); va_end(ap);
+    if (logf) { va_start(ap, fmt); vfprintf(logf, fmt, ap); va_end(ap); fflush(logf); }
+}
+static uint32_t ticks(void) { return cpuGetTiming(); }
+static unsigned to_us(uint32_t t) { return t / (BUS_CLOCK / 1000000u); }
+static unsigned crc32(unsigned crc, const uint8_t *p, size_t n)
+{
+    while (n--) { crc ^= *p++; for (int k = 0; k < 8; k++) crc = (crc >> 1) ^ (0xEDB88320u & (0u - (crc & 1u))); }
+    return crc;
+}
+/* The packet is already in RAM, so the bit reader must not pull from the
+ * stream again: the explicit read consumed all of it. */
+typedef struct { const uint8_t *data; size_t size, at; } mem_pull;
+static size_t pull(void *ctx, void *dst, size_t maximum)
+{
+    mem_pull *m = (mem_pull *)ctx;
+    size_t left = m->size - m->at;
+    if (left > maximum) left = maximum;
+    memcpy(dst, m->data + m->at, left);
+    m->at += left;
+    return left;
+}
+
+int main(void)
+{
+    unsigned frames = 0, is = 0, ps = 0, drops = 0, errors = 0;
+    unsigned aud_samples = 0, aud_underruns = 0, aud_bad = 0, aud_peak = 0;
+    uint32_t dec_sum = 0, tot_sum = 0, dec_max = 0, tot_max = 0, late_max = 0;
+    unsigned crc = 0xFFFFFFFFu;
+    int have_ref = 0, eof = 0, stopped = 0;
+    uint32_t read_ticks = 0, read_sum = 0, read_max = 0;
+    char path[48] = "fat:/play.fvds";
+
+    consoleDemoInit();
+    if (fatInitDefault()) {
+        const char *dev = 0;
+        for (int i = 3; i < 32; i++)
+            if (devoptab_list[i] && devoptab_list[i]->name) { dev = devoptab_list[i]->name; break; }
+        if (dev && strcmp(dev, "fat")) snprintf(path, sizeof path, "%s:/play.fvds", dev);
+        logf = fopen("fat:/P.TXT", "wb");
+    }
+    vramSetBankA(VRAM_A_LCD);
+    videoSetMode(MODE_5_2D);
+    cpuStartTiming(1);
+    soundEnable();
+    emit("R14 play start fat=%d file=%d log=%d\n", 1, 0, logf != 0);
+
+    nds_fvds_stream *s = &stream;
+    int rc = nds_fvds_open(s, path);
+    emit("R14 play open rc=%d w=%u h=%u fps=%u/%u frames=%u keys=%u\n", rc,
+         s->width, s->height, s->fps_num, s->fps_den, s->frame_count, s->keyframe_count);
+    if (rc) goto done;
+    emit("R14 play log=%d\n", logf != 0);
+    {
+        uint32_t budget_us = s->fps_num ? (1000000u * s->fps_den) / s->fps_num : 0;
+        uint32_t budget = budget_us * (BUS_CLOCK / 1000000u);
+        uint32_t start = ticks();
+        emit("R14 play budget=%u\n", budget_us);
+        for (;;) {
+            nds_fvds_packet pkt;
+            scanKeys();
+            if (keysDown() & KEY_B) { stopped = 1; break; }
+            if (frames >= MAXF) break;
+            { uint32_t t = ticks(); rc = nds_fvds_next(s, &pkt); read_ticks = ticks() - t; }
+            if (rc == 1) { eof = 1; break; }
+            if (rc < 0) {
+                errors++;
+                emit("R14 play perr f=%u rc=%d\n", frames, rc);
+                have_ref = 0;
+                break;
+            }
+            if (pkt.video_bytes > sizeof packet) { errors++; emit("R14 play big f=%u b=%u\n", frames, pkt.video_bytes); break; }
+            { uint32_t t = ticks();
+              if (nds_fvds_read_video(s, packet, pkt.video_bytes) != pkt.video_bytes) {
+                errors++; emit("R14 play short f=%u\n", frames); break;
+              }
+              read_ticks += ticks() - t;
+            }
+            if (frames == 0 || frames % 20 == 0) emit("R14 play pkt f=%u v=%u crc=%u\n", frames, pkt.video_bytes, crc32(0xFFFFFFFFu, packet, pkt.video_bytes) ^ 0xFFFFFFFFu);
+            uint32_t t0 = ticks();
+            /* Audio arrives as ADPCM block pairs; decode the whole packet and
+             * hand one 16 bit stereo buffer to the ARM7 sound channel. */
+            {
+                size_t want = pkt.audio_bytes, got = 0;
+                while (got < want) {
+                    size_t n = nds_fvds_read_audio(s, audiobuf + got, want - got);
+                    if (!n) break;
+                    got += n;
+                }
+                if (got != want) { aud_bad++; emit("R14 play ashort f=%u got=%u want=%u\n", frames, (unsigned)got, (unsigned)want); }
+                unsigned pairs = (unsigned)(got / NDS_FVDS_ADPCM_PAIR_BYTES), decoded = 0;
+                for (unsigned i = 0; i < pairs && decoded + NDS_FVDS_ADPCM_INTERLEAVED_SAMPLES <= sizeof pcm / sizeof pcm[0]; i++) {
+                    if (nds_fvds_adpcm_pair(audiobuf + i * NDS_FVDS_ADPCM_PAIR_BYTES,
+                                            NDS_FVDS_ADPCM_PAIR_BYTES,
+                                            pcm + decoded,
+                                            NDS_FVDS_ADPCM_INTERLEAVED_SAMPLES) != NDS_FVDS_ADPCM_SAMPLES_PER_BLOCK) { aud_bad++; break; }
+                    decoded += NDS_FVDS_ADPCM_INTERLEAVED_SAMPLES;
+                }
+                if (decoded) {
+                    for (unsigned i = 0; i < decoded * 2u; i++) {
+                        int v = pcm[i] < 0 ? -pcm[i] : pcm[i];
+                        if ((unsigned)v > aud_peak) aud_peak = (unsigned)v;
+                    }
+                    soundPlaySample(pcm, SoundFormat_16Bit, decoded * 4u, 47605, 110, 64, false, 0);
+                    aud_samples += decoded;
+                }
+                if (got != want) aud_underruns++;
+            }
+            mem_pull mp = { packet, pkt.video_bytes, 0 };
+            if (!nds_fvds_bits_init(&bits, pull, &mp, pkt.video_bytes)) {
+                errors++; emit("R14 play bits f=%u\n", frames); break;
+            }
+            int status;
+            if (s->current_is_keyframe) {
+                unsigned q = 0;
+                status = nds_fvds_iframe_decode(&bits, b_g, b_r, b_b, W, W, H, &q);
+                is++;
+                emit("R14 play iframe f=%u q=%u st=%d\n", frames, q, status);
+            } else {
+                if (!have_ref) {
+                    /* first P without reference: show nothing, wait for a keyframe */
+                    errors++;
+                    emit("R14 play noref f=%u\n", frames);
+                    if (nds_fvds_finish(s)) break;
+                    frames++;
+                    continue;
+                }
+                status = nds_fvds_pframe_decode(&bits, a_g, a_r, a_b, b_g, b_r, b_b, W, W, H, vectors);
+                ps++;
+            }
+            uint32_t t1 = ticks();
+            if (status < 0) {
+                errors++;
+                emit("R14 play decode f=%u st=%d\n", frames, status);
+                have_ref = 0;
+                if (nds_fvds_finish(s)) break;
+                continue;
+            }
+            if (nds_fvds_iframe_to_rgb555(b_g, b_r, b_b, W, rgbbuf, W, W, H)) {
+                errors++; emit("R14 play rgb f=%u\n", frames); break;
+            }
+            dmaCopy(rgbbuf, BG_BMP_RAM(0), sizeof rgbbuf);
+            uint32_t t2 = ticks();
+            while (dmaBusy(3)) ;
+            swiWaitForVBlank();
+            {
+                uint32_t dec = t1 - t0, tot = t2 - t0;
+                uint32_t due = start + (uint32_t)((uint64_t)frames * budget);
+                uint32_t late = 0;
+                if (ticks() > due) { late = ticks() - due; drops++; }
+                dec_sum += dec; tot_sum += tot;
+                read_sum += read_ticks;
+                if (read_ticks > read_max) read_max = read_ticks;
+                if (dec > dec_max) dec_max = dec;
+                if (tot > tot_max) tot_max = tot;
+                if (late > late_max) late_max = late;
+                crc = crc32(crc, (const uint8_t *)rgbbuf, sizeof rgbbuf);
+                if (frames % LOG_EVERY == 0)
+                    emit("PL f=%u i=%u dec=%u rd=%u tot=%u late=%u crc=%u\n", frames,
+                         s->current_is_keyframe, to_us(dec), to_us(read_ticks),
+                         to_us(tot), to_us(late), crc);
+            }
+            memcpy(a_g, b_g, PIX); memcpy(a_r, b_r, PIX); memcpy(a_b, b_b, PIX);
+            have_ref = 1;
+            read_ticks = 0;
+            frames++;
+            if (nds_fvds_finish(s)) break;
+        }
+    }
+done:
+    {
+        unsigned n = frames ? frames : 1;
+        emit("PY frames=%u i=%u p=%u drops=%u errors=%u eof=%d stop=%d crc=%u\n",
+             frames, is, ps, drops, errors, eof, stopped, crc);
+        emit("PY au samples=%u underruns=%u bad=%u peak=%u\n", aud_samples, aud_underruns, aud_bad, aud_peak);
+        emit("PY dec_avg=%u dec_max=%u rd_avg=%u rd_max=%u tot_avg=%u tot_max=%u late_max=%u\n",
+             to_us(dec_sum / n), to_us(dec_max), to_us(read_sum / n), to_us(read_max),
+             to_us(tot_sum / n), to_us(tot_max), to_us(late_max));
+    }
+    nds_fvds_close(&stream);
+    emit("R14 play done\n");
+    if (logf) { fclose(logf); logf = 0; }
+    for (;;) swiWaitForVBlank();
+    return 0;
+}
